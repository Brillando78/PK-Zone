{% extends 'base.html.twig' %}

{% block title %}Connexion - ParkingPro{% endblock %}

{% block auth_body %}
<div class="auth-container">
    <div class="auth-logo">
        <div class="auth-logo-icon">P</div>
        <span class="auth-logo-name">ParkingPro</span>
    </div>

    <div class="auth-card">
        <h2 class="auth-title">Bon retour ! </h2>
        <p class="auth-subtitle">Connectez-vous pour accéder à votre espace parking.</p>

        {% if error %}
            <div class="auth-error">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:18px;height:18px;flex-shrink:0"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% for message in app.flashes('success') %}
            <div class="auth-success">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:18px;height:18px;flex-shrink:0"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                {{ message }}
            </div>
        {% endfor %}

        <form action="{{ path('app_login') }}" method="POST" class="auth-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group">
                <label for="inputEmail" class="form-label">Adresse email</label>
                <input type="email"
                        id="inputEmail"
                        name="_username"
                        value="{{ last_username }}"
                        class="form-input"
                        placeholder="votre@email.com"
                        autocomplete="email"
                        required
                        autofocus>
            </div>

            <div class="form-group">
                <label for="inputPassword" class="form-label">Mot de passe</label>
                <input type="password"
                        id="inputPassword"
                        name="_password"
                        class="form-input"
                        placeholder="••••••••"
                        autocomplete="current-password"
                        required>
            </div>

            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1.25rem;">
                <input type="checkbox" id="remember_me" name="_remember_me" style="width:16px;height:16px;accent-color:var(--primary);cursor:pointer;">
                <label for="remember_me" style="font-size:0.875rem;color:var(--text-secondary);cursor:pointer;">Se souvenir de moi</label>
            </div>

            <button type="submit" class="btn-auth" id="btn-login">
                Se connecter
            </button>
        </form>

        <div class="auth-footer">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}">S'inscrire gratuitement</a>
        </div>
    </div>
</div>
{% endblock %}
